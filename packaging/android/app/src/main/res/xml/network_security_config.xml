<?xml version="1.0" encoding="utf-8"?>
<!-- The game's data packs are only on Activision's CDN over plain HTTP (the launcher checks
     their SHA-256). 127.0.0.1 is the phone itself: test servers reached through adb reverse
     (client.ini [launcher] update_api). Everything else stays HTTPS-only. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">cdn-boz-android.callofduty.com</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
