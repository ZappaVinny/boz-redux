#include <winver.h>

1 ICON "@BOZ_RC_ICON@"

1 24 "@BOZ_RC_MANIFEST@"

1 VERSIONINFO
FILEVERSION @BOZ_RC_VERSION_COMMAS@,0
PRODUCTVERSION @BOZ_RC_VERSION_COMMAS@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "BOZ Redux"
      VALUE "FileDescription", "@BOZ_RC_DESCRIPTION@"
      VALUE "FileVersion", "@BOZ_VERSION@"
      VALUE "InternalName", "@BOZ_RC_NAME@"
      VALUE "OriginalFilename", "@BOZ_RC_NAME@.exe"
      VALUE "ProductName", "BOZ Redux"
      VALUE "ProductVersion", "@BOZ_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
