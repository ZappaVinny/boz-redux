<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Runs as the user who starts it. Without this, Windows guesses that a 32-bit program whose
     name or description sounds like an installer needs administrator rights, and starting it
     from the launcher fails. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
