{
  "version": 6,
  "configurePresets": [
    {
      "name": "linux-x86",
      "displayName": "Linux 32-bit (x86)",
      "binaryDir": "${sourceDir}/build/linux-x86",
      "toolchainFile": "${sourceDir}/cmake/i686-linux.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "windows-x86",
      "displayName": "Windows 32-bit (x86, MinGW cross)",
      "binaryDir": "${sourceDir}/build/windows-x86",
      "toolchainFile": "${sourceDir}/cmake/i686-w64-mingw32.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "windows-x64-msys2",
      "displayName": "Windows 64-bit (x86-64, Dynarmic), built on Windows in an MSYS2 MINGW64 shell",
      "binaryDir": "${sourceDir}/build/windows-x64",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_RC_COMPILER": "windres"
      }
    },
    {
      "name": "windows-x86-msys2",
      "displayName": "Windows 32-bit (x86), built on Windows in an MSYS2 MINGW32 shell",
      "binaryDir": "${sourceDir}/build/windows-x86",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_RC_COMPILER": "windres"
      }
    },
    {
      "name": "windows-x64-base-msys2",
      "displayName": "Windows 64-bit with the game's memory at a base offset (tests the Android/Switch path), MSYS2 MINGW64",
      "binaryDir": "${sourceDir}/build/windows-x64-base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_RC_COMPILER": "windres",
        "BOZ_GUEST_BASE": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-x86",
      "configurePreset": "linux-x86",
      "targets": [
        "codboz_s3e_loader",
        "codboz_apk_extract",
        "boz-redux",
        "SDL2",
        "SDL2_mixer"
      ]
    },
    {
      "name": "linux-x86-tests",
      "configurePreset": "linux-x86"
    },
    {
      "name": "windows-x86",
      "configurePreset": "windows-x86",
      "targets": [
        "codboz_s3e_loader",
        "codboz_apk_extract",
        "boz-redux",
        "SDL2",
        "SDL2_mixer"
      ]
    },
    {
      "name": "windows-x86-msys2",
      "configurePreset": "windows-x86-msys2",
      "targets": [
        "codboz_s3e_loader",
        "codboz_apk_extract",
        "boz-redux",
        "SDL2",
        "SDL2_mixer"
      ]
    },
    {
      "name": "windows-x86-msys2-tests",
      "configurePreset": "windows-x86-msys2"
    },
    {
      "name": "windows-x64-msys2",
      "configurePreset": "windows-x64-msys2",
      "targets": [
        "codboz_s3e_loader",
        "codboz_apk_extract",
        "boz-redux",
        "SDL2",
        "SDL2_mixer"
      ]
    },
    {
      "name": "windows-x64-msys2-tests",
      "configurePreset": "windows-x64-msys2"
    },
    {
      "name": "windows-x64-base-msys2",
      "configurePreset": "windows-x64-base-msys2",
      "targets": [
        "codboz_s3e_loader",
        "codboz_apk_extract",
        "boz-redux",
        "SDL2",
        "SDL2_mixer"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "linux-x86",
      "configurePreset": "linux-x86",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
